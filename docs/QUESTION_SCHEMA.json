{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naranusa.local/schemas/question.json",
  "title": "NaraNusa Question",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subjectId", "topicId", "type", "stem", "choices", "answerIndex", "explanation", "sourceIds", "sourceLocator", "reviewStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "subjectId": { "enum": ["matematika", "bahasa-indonesia", "ipas", "pendidikan-pancasila"] },
    "topicId": { "type": "string", "minLength": 1 },
    "type": { "const": "multiple-choice" },
    "stem": { "type": "string", "minLength": 10 },
    "choices": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1 } },
    "answerIndex": { "type": "integer", "minimum": 0, "maximum": 3 },
    "explanation": { "type": "string", "minLength": 5 },
    "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "sourceLocator": { "type": "string", "minLength": 3 },
    "reviewStatus": { "enum": ["needs_teacher_review", "approved", "rejected"] }
  }
}
